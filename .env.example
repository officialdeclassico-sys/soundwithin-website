# GEMINI_API_KEY: Required for Gemini AI API calls.
# AI Studio automatically injects this at runtime from user secrets.
GEMINI_API_KEY="MY_GEMINI_API_KEY"

# APP_URL: The URL where this applet is hosted.
APP_URL="MY_APP_URL"

# ADMIN_PASSWORD: Password for accessing the SoundWithin Admin Management Portal.
# Defaults to "soundwithin-admin" in demo/development if not set.
ADMIN_PASSWORD=""

# RAZORPAY CREDENTIALS (Optional - required only to activate live online Razorpay payments)
RAZORPAY_KEY_ID=""
RAZORPAY_KEY_SECRET=""

# SMTP EMAIL CONFIGURATION (Optional - required to send live transactional emails on bookings/enquiries)
SMTP_HOST=""
SMTP_PORT="587"
SMTP_USER=""
SMTP_PASS=""
NOTIFICATION_EMAIL=""
